FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    wget \
    curl \
    unzip \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libgles2 \
    libegl1 \
    build-essential \
    cmake \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY docker/requirements-base.txt /tmp/requirements-base.txt
COPY docker/requirements-hpe.txt /tmp/requirements-hpe.txt
COPY docker/requirements-mmpose.txt /tmp/requirements-mmpose.txt

RUN python3 -m pip install --upgrade "pip<25" "setuptools<82" wheel && \
    python3 -m pip install -r /tmp/requirements-base.txt && \
    python3 -m pip install -r /tmp/requirements-hpe.txt && \
    python3 -m pip install \
        torch==2.1.0 \
        torchvision==0.16.0 \
        torchaudio==2.1.0 && \
    python3 -m pip install -r /tmp/requirements-mmpose.txt && \
    mim install mmengine && \
    mim install mmcv==2.1.0 && \
    mim install "mmdet>=3.2.0" && \
    python3 -m pip install --no-deps mmpose==1.3.2

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

<?xml version="1.0"?>
<robot name="full_humanoid_upper_body_test">
  <material name="gray"><color rgba="0.55 0.55 0.55 1"/></material>
  <material name="blue"><color rgba="0.1 0.25 0.9 1"/></material>
  <material name="green"><color rgba="0.1 0.8 0.2 1"/></material>
  <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="world"/>

  <link name="pelvis">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.28 0.20 0.16"/></geometry><material name="gray"/></visual>
  </link>
  <joint name="floating_base_joint" type="fixed"><parent link="world"/><child link="pelvis"/><origin xyz="0 0 1.0" rpy="0 0 0"/></joint>

  <link name="torso_link"><visual><origin xyz="0 0 0.22"/><geometry><box size="0.32 0.18 0.44"/></geometry><material name="gray"/></visual></link>
  <joint name="torso_joint" type="revolute"><parent link="pelvis"/><child link="torso_link"/><origin xyz="0 0 0.12"/><axis xyz="0 0 1"/><limit lower="-0.7" upper="0.7" effort="50" velocity="2"/></joint>

  <link name="neck_link"><visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.04" length="0.10"/></geometry><material name="dark"/></visual></link>
  <joint name="neck_joint" type="fixed"><parent link="torso_link"/><child link="neck_link"/><origin xyz="0 0 0.48"/></joint>
  <link name="head_link"><visual><origin xyz="0 0 0.10"/><geometry><sphere radius="0.10"/></geometry><material name="gray"/></visual></link>
  <joint name="head_joint" type="fixed"><parent link="neck_link"/><child link="head_link"/><origin xyz="0 0 0.10"/></joint>

  <!-- Left arm: 3-DOF shoulder + elbow -->
  <link name="left_shoulder_pitch_link"><visual><geometry><sphere radius="0.045"/></geometry><material name="blue"/></visual></link>
  <joint name="left_shoulder_pitch_joint" type="revolute"><parent link="torso_link"/><child link="left_shoulder_pitch_link"/><origin xyz="0 0.20 0.38"/><axis xyz="0 0 1"/><limit lower="-2.8" upper="2.8" effort="40" velocity="3"/></joint>
  <link name="left_shoulder_roll_link"><visual><geometry><sphere radius="0.04"/></geometry><material name="blue"/></visual></link>
  <joint name="left_shoulder_roll_joint" type="revolute"><parent link="left_shoulder_pitch_link"/><child link="left_shoulder_roll_link"/><axis xyz="1 0 0"/><limit lower="-1.8" upper="1.8" effort="40" velocity="3"/></joint>
  <link name="left_shoulder_yaw_link"><visual><geometry><sphere radius="0.035"/></geometry><material name="blue"/></visual></link>
  <joint name="left_shoulder_yaw_joint" type="revolute"><parent link="left_shoulder_roll_link"/><child link="left_shoulder_yaw_link"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="40" velocity="3"/></joint>
  <link name="left_upper_arm_link"><visual><origin xyz="0 0.135 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.27"/></geometry><material name="blue"/></visual></link>
  <joint name="left_upper_arm_fixed" type="fixed"><parent link="left_shoulder_yaw_link"/><child link="left_upper_arm_link"/><origin xyz="0 0.135 0"/></joint>
  <link name="left_elbow_link"><visual><geometry><sphere radius="0.04"/></geometry><material name="blue"/></visual></link>
  <joint name="left_elbow_joint" type="revolute"><parent link="left_upper_arm_link"/><child link="left_elbow_link"/><origin xyz="0 0.27 0"/><axis xyz="1 0 0"/><limit lower="0.0" upper="2.4" effort="30" velocity="3"/></joint>
  <link name="left_forearm_link"><visual><origin xyz="0 0.12 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="0.24"/></geometry><material name="green"/></visual></link>
  <joint name="left_forearm_fixed" type="fixed"><parent link="left_elbow_link"/><child link="left_forearm_link"/><origin xyz="0 0.12 0"/></joint>
  <link name="left_hand_link"><visual><origin xyz="0 0.04 0"/><geometry><box size="0.06 0.08 0.03"/></geometry><material name="green"/></visual></link>
  <joint name="left_hand_fixed" type="fixed"><parent link="left_forearm_link"/><child link="left_hand_link"/><origin xyz="0 0.25 0"/></joint>

  <!-- Right arm -->
  <link name="right_shoulder_pitch_link"><visual><geometry><sphere radius="0.045"/></geometry><material name="blue"/></visual></link>
  <joint name="right_shoulder_pitch_joint" type="revolute"><parent link="torso_link"/><child link="right_shoulder_pitch_link"/><origin xyz="0 -0.20 0.38"/><axis xyz="0 0 1"/><limit lower="-2.8" upper="2.8" effort="40" velocity="3"/></joint>
  <link name="right_shoulder_roll_link"><visual><geometry><sphere radius="0.04"/></geometry><material name="blue"/></visual></link>
  <joint name="right_shoulder_roll_joint" type="revolute"><parent link="right_shoulder_pitch_link"/><child link="right_shoulder_roll_link"/><axis xyz="-1 0 0"/><limit lower="-1.8" upper="1.8" effort="40" velocity="3"/></joint>
  <link name="right_shoulder_yaw_link"><visual><geometry><sphere radius="0.035"/></geometry><material name="blue"/></visual></link>
  <joint name="right_shoulder_yaw_joint" type="revolute"><parent link="right_shoulder_roll_link"/><child link="right_shoulder_yaw_link"/><axis xyz="0 -1 0"/><limit lower="-2.5" upper="2.5" effort="40" velocity="3"/></joint>
  <link name="right_upper_arm_link"><visual><origin xyz="0 -0.135 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.27"/></geometry><material name="blue"/></visual></link>
  <joint name="right_upper_arm_fixed" type="fixed"><parent link="right_shoulder_yaw_link"/><child link="right_upper_arm_link"/><origin xyz="0 -0.135 0"/></joint>
  <link name="right_elbow_link"><visual><geometry><sphere radius="0.04"/></geometry><material name="blue"/></visual></link>
  <joint name="right_elbow_joint" type="revolute"><parent link="right_upper_arm_link"/><child link="right_elbow_link"/><origin xyz="0 -0.27 0"/><axis xyz="-1 0 0"/><limit lower="0.0" upper="2.4" effort="30" velocity="3"/></joint>
  <link name="right_forearm_link"><visual><origin xyz="0 -0.12 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="0.24"/></geometry><material name="green"/></visual></link>
  <joint name="right_forearm_fixed" type="fixed"><parent link="right_elbow_link"/><child link="right_forearm_link"/><origin xyz="0 -0.12 0"/></joint>
  <link name="right_hand_link"><visual><origin xyz="0 -0.04 0"/><geometry><box size="0.06 0.08 0.03"/></geometry><material name="green"/></visual></link>
  <joint name="right_hand_fixed" type="fixed"><parent link="right_forearm_link"/><child link="right_hand_link"/><origin xyz="0 -0.25 0"/></joint>

  <!-- Legs are present for full robot visualization, but Home mode does not control them. -->
  <link name="left_thigh_link"><visual><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.045" length="0.40"/></geometry><material name="dark"/></visual></link>
  <joint name="left_hip_joint" type="fixed"><parent link="pelvis"/><child link="left_thigh_link"/><origin xyz="0 0.09 -0.08"/></joint>
  <link name="left_shin_link"><visual><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.04" length="0.40"/></geometry><material name="dark"/></visual></link>
  <joint name="left_knee_joint" type="fixed"><parent link="left_thigh_link"/><child link="left_shin_link"/><origin xyz="0 0 -0.40"/></joint>
  <link name="left_foot_link"><visual><origin xyz="0.07 0 -0.03"/><geometry><box size="0.20 0.08 0.04"/></geometry><material name="dark"/></visual></link>
  <joint name="left_ankle_joint" type="fixed"><parent link="left_shin_link"/><child link="left_foot_link"/><origin xyz="0 0 -0.40"/></joint>

  <link name="right_thigh_link"><visual><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.045" length="0.40"/></geometry><material name="dark"/></visual></link>
  <joint name="right_hip_joint" type="fixed"><parent link="pelvis"/><child link="right_thigh_link"/><origin xyz="0 -0.09 -0.08"/></joint>
  <link name="right_shin_link"><visual><origin xyz="0 0 -0.20"/><geometry><cylinder radius="0.04" length="0.40"/></geometry><material name="dark"/></visual></link>
  <joint name="right_knee_joint" type="fixed"><parent link="right_thigh_link"/><child link="right_shin_link"/><origin xyz="0 0 -0.40"/></joint>
  <link name="right_foot_link"><visual><origin xyz="0.07 0 -0.03"/><geometry><box size="0.20 0.08 0.04"/></geometry><material name="dark"/></visual></link>
  <joint name="right_ankle_joint" type="fixed"><parent link="right_shin_link"/><child link="right_foot_link"/><origin xyz="0 0 -0.40"/></joint>
</robot>
